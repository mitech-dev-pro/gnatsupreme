NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:replace-with-password@localhost:5432/gnatsupreme?schema=public"
JWT_ACCESS_SECRET="generate-a-random-secret-containing-at-least-64-characters"
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=gnat_refresh_token
MEMBER_REFRESH_COOKIE_NAME=gnat_member_refresh_token
MEMBER_ACCESS_TTL_MINUTES=10
MEMBER_SESSION_TTL_DAYS=7
MEMBER_PASSWORD_RESET_TTL_MINUTES=60
SMS_PROVIDER=CONSOLE
API_DOCS_ENABLED=true
LOG_LEVEL=debug
LOG_FILE=logs/app.log
FRONTEND_ORIGIN=http://localhost:3000
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
# Optional for local development — leave unset (or comment out) to run member/Report 20 import
# jobs inline in the API process instead of via BullMQ+Redis+a separate worker. Required in
# production (npm run start:production / worker).
REDIS_URL=redis://127.0.0.1:6379
WORKER_CONCURRENCY=2
MANKRADO_ENABLED=false
MANKRADO_MODE=API
MANKRADO_BASE_URL=
MANKRADO_API_KEY=
