NODE_ENV=production
PORT=4000
DATABASE_URL="postgresql://gnatsupreme:replace-with-strong-password@127.0.0.1:5432/gnatsupreme?schema=public"
JWT_ACCESS_SECRET="replace-with-at-least-64-random-characters"
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=gnat_refresh_token
MEMBER_REFRESH_COOKIE_NAME=gnat_member_refresh_token
MEMBER_ACCESS_TTL_MINUTES=10
MEMBER_SESSION_TTL_DAYS=7
MEMBER_OTP_TTL_MINUTES=5
FRONTEND_ORIGIN=https://portal.example.com
UPLOAD_DIR=/var/lib/gnatsupreme/uploads
MAX_UPLOAD_SIZE_MB=10
API_DOCS_ENABLED=false
LOG_LEVEL=info
LOG_FILE=/var/log/gnatsupreme/app.log

# CONSOLE is intentionally rejected in production. Add and select a real
# provider adapter, such as HUBTEL, before deploying.
SMS_PROVIDER=CONSOLE
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=

MANKRADO_ENABLED=false
MANKRADO_MODE=API
MANKRADO_BASE_URL=
MANKRADO_API_KEY=
