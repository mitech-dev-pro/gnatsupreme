NODE_ENV=production
PORT=4000
DATABASE_URL="postgresql://gnatsupreme:replace-with-strong-password@127.0.0.1:5432/gnatsupreme?schema=public"
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
JWT_ACCESS_SECRET="replace-with-at-least-64-random-characters"
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=gnat_refresh_token
MEMBER_REFRESH_COOKIE_NAME=gnat_member_refresh_token
MEMBER_ACCESS_TTL_MINUTES=10
MEMBER_SESSION_TTL_DAYS=7
MEMBER_PASSWORD_RESET_TTL_MINUTES=60
FRONTEND_ORIGIN=https://portal.example.com
UPLOAD_DIR=/var/lib/gnatsupreme/uploads
MAX_UPLOAD_SIZE_MB=10
REDIS_URL="redis://:replace-with-a-strong-redis-password@127.0.0.1:6379"
AUTH_CACHE_TTL_SECONDS=30
READ_CACHE_TTL_SECONDS=60
SLOW_REQUEST_THRESHOLD_MS=750
WORKER_CONCURRENCY=2
API_DOCS_ENABLED=false
LOG_LEVEL=info
LOG_FILE=/var/log/gnatsupreme/app.log

# SMS isn't in use — CONSOLE just logs instead of sending, which is fine here.
SMS_PROVIDER=CONSOLE

MANKRADO_ENABLED=false
MANKRADO_MODE=API
MANKRADO_BASE_URL=
MANKRADO_API_KEY=
