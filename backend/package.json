{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "start:production": "node dist/server.js",
    "worker": "node dist/worker.js",
    "migrate:deploy": "prisma migrate deploy",
    "deploy:check": "npm run typecheck && npm run build && prisma migrate status",
    "deploy-update": "bash scripts/deploy-update.sh",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "admin:create": "tsx scripts/create-admin.ts",
    "admin:reset-password": "tsx scripts/reset-admin-password.ts",
    "db:seed-geography": "tsx scripts/seed-geography.ts",
    "verify:member-scope": "tsx scripts/verify-member-scope.ts",
    "clear:members-and-uploads": "tsx scripts/clear-members-and-uploads.ts",
    "verify:performance-indexes": "node scripts/verify-performance-indexes.mjs",
    "verify:performance-runtime": "node scripts/verify-performance-runtime.mjs",
    "verify:performance": "npm run verify:performance-indexes && npm run verify:performance-runtime",
    "performance:slow-queries": "node scripts/report-slow-queries.mjs",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "argon2": "^0.45.1",
    "bullmq": "^5.81.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.9",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
