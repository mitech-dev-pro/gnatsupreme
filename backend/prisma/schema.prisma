// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  NATIONAL_ADMIN
  REGIONAL_ADMIN
  DISTRICT_ADMIN

  @@map("user_role")
}

enum MemberStatus {
  ACTIVE
  PENDING
  FLAGGED
  RETURNED
  REMOVED
  INACTIVE

  @@map("member_status")
}

enum BeneficiaryRelationship {
  CHILD
  SPOUSE
  PARENT
  SIBLING
  OTHER

  @@map("beneficiary_relationship")
}

enum FileCategory {
  MEMBER_DOCUMENT
  MARRIAGE_CERTIFICATE
  REPORT_20
  MEMBER_IMPORT
  MEMBER_CREDENTIALS
  OTHER

  @@map("file_category")
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("transfer_status")
}

enum ExternalClaimStatus {
  PENDING
  REDIRECT_READY
  SUBMITTED
  FAILED
  SYNCHRONIZED

  @@map("external_claim_status")
}

enum ImportType {
  REPORT_20
  MEMBER_BULK

  @@map("import_type")
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@map("import_status")
}

enum ImportRowStatus {
  MATCHED
  CHANGED
  UNMATCHED
  DUPLICATE
  INVALID
  ENROLLED

  @@map("import_row_status")
}

enum BenefitType {
  DEATH
  TOTAL_PERMANENT_DISABILITY
  CRITICAL_ILLNESS
  HOSPITALIZATION

  @@map("benefit_type")
}

enum BulkImportRowStatus {
  READY
  INVALID
  DUPLICATE
  EXISTING
  OUT_OF_SCOPE
  IMPORTED
  FAILED

  @@map("bulk_import_row_status")
}

enum MemberWorkflowAction {
  APPROVED
  RETURNED
  REMOVED
  INACTIVATED
  REACTIVATED

  @@map("member_workflow_action")
}

enum RemovalReason {
  DEATH
  DISABILITY
  RETIREMENT
  RESIGNATION
  OTHER

  @@map("removal_reason")
}

enum ChangeRequestType {
  MEMBER_DETAILS
  SPOUSE
  BENEFICIARY_ADD
  BENEFICIARY_UPDATE
  BENEFICIARY_REMOVE

  @@map("change_request_type")
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  RETURNED
  REJECTED
  CANCELLED

  @@map("change_request_status")
}

enum SpouseDeclarationStatus {
  UNKNOWN
  NONE
  HAS_SPOUSE

  @@map("spouse_declaration_status")
}

enum NotificationChannel {
  IN_APP
  SMS

  @@map("notification_channel")
}

enum NotificationStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  CANCELLED

  @@map("notification_status")
}

model Region {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  districts District[]
  users     User[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("regions")
}

model District {
  id                Int              @id @default(autoincrement())
  name              String
  regionId          Int              @map("region_id")
  region            Region           @relation(fields: [regionId], references: [id], onDelete: Restrict)
  users             User[]
  members           Member[]
  outgoingTransfers MemberTransfer[] @relation("TransferFromDistrict")
  incomingTransfers MemberTransfer[] @relation("TransferToDistrict")
  aliases           DistrictAlias[]
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@unique([regionId, name])
  @@index([regionId])
  @@map("districts")
}

model DistrictAlias {
  id          Int      @id @default(autoincrement())
  alias       String   @unique
  districtId  Int      @map("district_id")
  district    District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  createdById Int?     @map("created_by_id")
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([districtId])
  @@map("district_aliases")
}

model User {
  id                          Int                           @id @default(autoincrement())
  fullName                    String                        @map("full_name")
  email                       String                        @unique
  passwordHash                String                        @map("password_hash")
  role                        UserRole
  isActive                    Boolean                       @default(true) @map("is_active")
  regionId                    Int?                          @map("region_id")
  districtId                  Int?                          @map("district_id")
  region                      Region?                       @relation(fields: [regionId], references: [id], onDelete: Restrict)
  district                    District?                     @relation(fields: [districtId], references: [id], onDelete: Restrict)
  createdMembers              Member[]                      @relation("MemberCreatedBy")
  refreshTokens               RefreshToken[]
  uploadedFiles               StoredFile[]
  auditLogs                   AuditLog[]
  requestedTransfers          MemberTransfer[]              @relation("TransferRequestedBy")
  reviewedTransfers           MemberTransfer[]              @relation("TransferReviewedBy")
  claimSubmissions            ExternalClaimSubmission[]
  importJobs                  ImportJob[]
  benefitPlans                BenefitPlanVersion[]
  memberWorkflowEvents        MemberWorkflowEvent[]
  submittedChangeRequests     MemberChangeRequest[]         @relation("ChangeRequestedBy")
  reviewedChangeRequests      MemberChangeRequest[]         @relation("ChangeReviewedBy")
  notifications               Notification[]
  organizationSettingsUpdates OrganizationSettings[]
  organizationSettingVersions OrganizationSettingsVersion[]
  districtAliasesCreated      DistrictAlias[]
  createdAt                   DateTime                      @default(now()) @map("created_at")
  updatedAt                   DateTime                      @updatedAt @map("updated_at")

  @@index([regionId])
  @@index([districtId])
  @@map("users")
}

model Member {
  id               Int                       @id @default(autoincrement())
  controllerId     String                    @unique @map("controller_id")
  fullName         String                    @map("full_name")
  dateOfBirth      DateTime?                 @map("date_of_birth") @db.Date
  ghanaCardId      String?                   @unique @map("ghana_card_id")
  phone            String?                   @unique
  phoneVerifiedAt  DateTime?                 @map("phone_verified_at")
  email            String?                   @unique
  passwordHash     String?                   @map("password_hash")
  school           String
  status           MemberStatus              @default(PENDING)
  report20Matched  Boolean                   @default(false) @map("report20_matched")
  missingFromReport20At DateTime?            @map("missing_from_report20_at")
  spouseDeclarationStatus SpouseDeclarationStatus @default(UNKNOWN) @map("spouse_declaration_status")
  profileCompletionDismissedAt DateTime?     @map("profile_completion_dismissed_at")
  districtId       Int?                      @map("district_id")
  createdById      Int?                      @map("created_by_id")
  district         District?                 @relation(fields: [districtId], references: [id], onDelete: Restrict)
  createdBy        User?                     @relation("MemberCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  spouse           Spouse?
  beneficiaries    Beneficiary[]
  files            StoredFile[]
  uploadedFiles    StoredFile[]              @relation("StoredFileUploadedByMember")
  transfers        MemberTransfer[]
  claimSubmissions ExternalClaimSubmission[]
  importRows       Report20Row[]
  bulkImportRows   MemberBulkImportRow[]
  workflowEvents   MemberWorkflowEvent[]
  changeRequests   MemberChangeRequest[]
  memberSessions   MemberSession[]
  passwordResetTokens MemberPasswordResetToken[]
  notifications    Notification[]
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  @@index([districtId])
  @@index([status])
  @@index([fullName])
  @@map("members")
}

model Spouse {
  id          Int          @id @default(autoincrement())
  memberId    Int          @unique @map("member_id")
  member      Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  fullName    String       @map("full_name")
  dateOfBirth DateTime?    @map("date_of_birth") @db.Date
  ghanaCardId String?      @unique @map("ghana_card_id")
  files       StoredFile[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("spouses")
}

model Beneficiary {
  id                 Int                     @id @default(autoincrement())
  memberId           Int                     @map("member_id")
  member             Member                  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  fullName           String                  @map("full_name")
  relationship       BeneficiaryRelationship
  dateOfBirth        DateTime?               @map("date_of_birth") @db.Date
  trusteeName        String?                 @map("trustee_name")
  trusteeGhanaCardId String?                 @map("trustee_ghana_card_id")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  @@index([memberId])
  @@map("beneficiaries")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique @map("token_hash")
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// Self-service password reset, used only when the member has an email on file (see
// member-auth.routes.ts /forgot-password). A member without an email can't use this path at all —
// a system user resets their password directly instead (Member.passwordHash, set via
// PATCH /members/:id/password), which needs no token.
model MemberPasswordResetToken {
  id         Int       @id @default(autoincrement())
  memberId   Int       @map("member_id")
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  ipAddress  String?   @map("ip_address")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([memberId, createdAt])
  @@index([expiresAt])
  @@map("member_password_reset_tokens")
}

model MemberSession {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique @map("token_hash")
  memberId  Int       @map("member_id")
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([memberId])
  @@index([expiresAt])
  @@map("member_sessions")
}

model Notification {
  id                Int                 @id @default(autoincrement())
  channel           NotificationChannel
  status            NotificationStatus  @default(QUEUED)
  type              String
  title             String
  message           String
  idempotencyKey    String              @unique @map("idempotency_key")
  userId            Int?                @map("user_id")
  user              User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberId          Int?                @map("member_id")
  member            Member?             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  destination       String?
  attempts          Int                 @default(0)
  maxAttempts       Int                 @default(5) @map("max_attempts")
  nextAttemptAt     DateTime            @default(now()) @map("next_attempt_at")
  providerMessageId String?             @map("provider_message_id")
  lastError         String?             @map("last_error")
  sentAt            DateTime?           @map("sent_at")
  readAt            DateTime?           @map("read_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@index([userId, readAt, createdAt])
  @@index([memberId, readAt, createdAt])
  @@index([type])
  @@map("notifications")
}

model OrganizationSettings {
  id                   Int                           @id @default(autoincrement())
  singletonKey         String                        @unique @default("MILIFE") @map("singleton_key")
  portalName           String                        @default("GNAT Supreme Care") @map("portal_name")
  schemeSponsor        String                        @default("GNAT") @map("scheme_sponsor")
  underwriter          String                        @default("miLife Insurance")
  sidebarMark          String                        @default("GS") @map("sidebar_mark")
  primaryColor         String                        @default("#102A43") @map("primary_color")
  accentColor          String                        @default("#00A896") @map("accent_color")
  memberIdLabel        String                        @default("Controller ID") @map("member_id_label")
  reconciliationSource String                        @default("CAGD Report 20") @map("reconciliation_source")
  subRegionLabel       String                        @default("District") @map("sub_region_label")
  organizationEmail    String?                       @map("organization_email")
  organizationPhone    String?                       @map("organization_phone")
  address              String?
  websiteUrl           String?                       @map("website_url")
  privacyNotice        String?                       @map("privacy_notice")
  timezone             String                        @default("Africa/Accra")
  currency             String                        @default("GHS")
  version              Int                           @default(1)
  updatedById          Int?                          @map("updated_by_id")
  updatedBy            User?                         @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  versions             OrganizationSettingsVersion[]
  createdAt            DateTime                      @default(now()) @map("created_at")
  updatedAt            DateTime                      @updatedAt @map("updated_at")

  @@index([updatedById])
  @@map("organization_settings")
}

model OrganizationSettingsVersion {
  id            Int                  @id @default(autoincrement())
  settingsId    Int                  @map("settings_id")
  settings      OrganizationSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  version       Int
  snapshot      Json
  changedFields Json                 @map("changed_fields")
  changedById   Int?                 @map("changed_by_id")
  changedBy     User?                @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now()) @map("created_at")

  @@unique([settingsId, version])
  @@index([changedById])
  @@index([createdAt])
  @@map("organization_settings_versions")
}

model StoredFile {
  id           Int          @id @default(autoincrement())
  category     FileCategory
  originalName String       @map("original_name")
  storedName   String       @unique @map("stored_name")
  mimeType     String       @map("mime_type")
  sizeBytes    Int          @map("size_bytes")
  storagePath  String       @unique @map("storage_path")
  downloadPath String       @unique @map("download_path")
  memberId     Int?         @map("member_id")
  spouseId     Int?         @map("spouse_id")
  // Exactly one of these is set: uploadedById for a staff upload, uploadedByMemberId for a
  // member's own self-service upload (e.g. their marriage certificate) — enforced in app code,
  // since Prisma has no "exactly one of" constraint.
  uploadedById       Int?    @map("uploaded_by_id")
  uploadedByMemberId Int?    @map("uploaded_by_member_id")
  member       Member?      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  spouse       Spouse?      @relation(fields: [spouseId], references: [id], onDelete: SetNull)
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadedByMember Member?  @relation("StoredFileUploadedByMember", fields: [uploadedByMemberId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now()) @map("created_at")
  importJob    ImportJob?

  @@index([memberId])
  @@index([spouseId])
  @@index([uploadedById])
  @@index([uploadedByMemberId])
  @@index([category])
  @@map("stored_files")
}

model ImportJob {
  id            Int                   @id @default(autoincrement())
  type          ImportType
  status        ImportStatus          @default(PENDING)
  checksum      String
  fileId        Int                   @unique @map("file_id")
  file          StoredFile            @relation(fields: [fileId], references: [id], onDelete: Restrict)
  uploadedById  Int                   @map("uploaded_by_id")
  uploadedBy    User                  @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  reportMonth   DateTime?             @map("report_month") @db.Date
  totalRows     Int                   @default(0) @map("total_rows")
  matchedRows   Int                   @default(0) @map("matched_rows")
  changedRows   Int                   @default(0) @map("changed_rows")
  unmatchedRows Int                   @default(0) @map("unmatched_rows")
  duplicateRows Int                   @default(0) @map("duplicate_rows")
  invalidRows   Int                   @default(0) @map("invalid_rows")
  errorMessage  String?               @map("error_message")
  startedAt     DateTime?             @map("started_at")
  completedAt   DateTime?             @map("completed_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  rows          Report20Row[]
  memberRows    MemberBulkImportRow[]
  readyRows     Int                   @default(0) @map("ready_rows")
  importedRows  Int                   @default(0) @map("imported_rows")
  enrolledRows  Int                   @default(0) @map("enrolled_rows")
  flaggedForRemovalRows Int           @default(0) @map("flagged_for_removal_rows")
  processedRows Int                   @default(0) @map("processed_rows")

  @@unique([type, checksum])
  @@index([status])
  @@index([createdAt])
  @@map("import_jobs")
}

model Report20Row {
  id           Int             @id @default(autoincrement())
  importJobId  Int             @map("import_job_id")
  importJob    ImportJob       @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  rowNumber    Int             @map("row_number")
  controllerId String?         @map("controller_id")
  fullName     String?         @map("full_name")
  districtName String?         @map("district_name")
  school       String?
  ghanaCardId  String?         @map("ghana_card_id")
  status       ImportRowStatus
  memberId     Int?            @map("member_id")
  member       Member?         @relation(fields: [memberId], references: [id], onDelete: SetNull)
  issues       Json?
  rawData      Json            @map("raw_data")
  createdAt    DateTime        @default(now()) @map("created_at")

  @@unique([importJobId, rowNumber])
  @@index([importJobId, status])
  @@index([controllerId])
  @@index([memberId])
  @@map("report20_rows")
}

model MemberBulkImportRow {
  id              Int                 @id @default(autoincrement())
  importJobId     Int                 @map("import_job_id")
  importJob       ImportJob           @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  rowNumber       Int                 @map("row_number")
  controllerId    String?             @map("controller_id")
  fullName        String?             @map("full_name")
  school          String?
  districtName    String?             @map("district_name")
  districtId      Int?                @map("district_id")
  dateOfBirth     DateTime?           @map("date_of_birth") @db.Date
  ghanaCardId     String?             @map("ghana_card_id")
  phone           String?
  report20Matched Boolean             @default(false) @map("report20_matched")
  status          BulkImportRowStatus
  memberId        Int?                @map("member_id")
  member          Member?             @relation(fields: [memberId], references: [id], onDelete: SetNull)
  issues          Json?
  rawData         Json                @map("raw_data")
  createdAt       DateTime            @default(now()) @map("created_at")

  @@unique([importJobId, rowNumber])
  @@index([importJobId, status])
  @@index([controllerId])
  @@index([memberId])
  @@index([districtId])
  @@map("member_bulk_import_rows")
}

model MemberWorkflowEvent {
  id            Int                  @id @default(autoincrement())
  memberId      Int                  @map("member_id")
  member        Member               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  action        MemberWorkflowAction
  fromStatus    MemberStatus         @map("from_status")
  toStatus      MemberStatus         @map("to_status")
  reason        RemovalReason?
  note          String?
  performedById Int?                 @map("performed_by_id")
  performedBy   User?                @relation(fields: [performedById], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now()) @map("created_at")

  @@index([memberId, createdAt])
  @@index([action])
  @@index([performedById])
  @@map("member_workflow_events")
}

model MemberChangeRequest {
  id                  Int                 @id @default(autoincrement())
  memberId            Int                 @map("member_id")
  member              Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type                ChangeRequestType
  status              ChangeRequestStatus @default(PENDING)
  targetBeneficiaryId Int?                @map("target_beneficiary_id")
  proposedData        Json?               @map("proposed_data")
  requestNote         String?             @map("request_note")
  requestedById       Int?                @map("requested_by_id")
  requestedBy         User?               @relation("ChangeRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedById        Int?                @map("reviewed_by_id")
  reviewedBy          User?               @relation("ChangeReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote          String?             @map("review_note")
  requestedAt         DateTime            @default(now()) @map("requested_at")
  reviewedAt          DateTime?           @map("reviewed_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  @@index([memberId, status])
  @@index([requestedById])
  @@index([reviewedById])
  @@index([requestedAt])
  @@map("member_change_requests")
}

model BenefitPlanVersion {
  id               Int             @id @default(autoincrement())
  effectiveFrom    DateTime        @unique @map("effective_from") @db.Date
  monthlyPremium   Decimal         @map("monthly_premium") @db.Decimal(12, 2)
  collectionMethod String          @map("collection_method")
  note             String?
  createdById      Int             @map("created_by_id")
  createdBy        User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  benefits         BenefitAmount[]
  createdAt        DateTime        @default(now()) @map("created_at")

  @@index([effectiveFrom])
  @@index([createdById])
  @@map("benefit_plan_versions")
}

model BenefitAmount {
  id            Int                @id @default(autoincrement())
  planVersionId Int                @map("plan_version_id")
  planVersion   BenefitPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  type          BenefitType
  enabled       Boolean            @default(true)
  memberAmount  Decimal            @map("member_amount") @db.Decimal(14, 2)
  spouseAmount  Decimal?           @map("spouse_amount") @db.Decimal(14, 2)
  note          String?
  namedConditions String[]         @default([]) @map("named_conditions")

  @@unique([planVersionId, type])
  @@index([type])
  @@map("benefit_amounts")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorId     Int?     @map("actor_id")
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail  String?  @map("actor_email")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  description String
  beforeData  Json?    @map("before_data")
  afterData   Json?    @map("after_data")
  regionId    Int?     @map("region_id")
  districtId  Int?     @map("district_id")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([regionId])
  @@index([districtId])
  @@index([createdAt])
  @@map("audit_logs")
}

model MemberTransfer {
  id             Int            @id @default(autoincrement())
  memberId       Int            @map("member_id")
  member         Member         @relation(fields: [memberId], references: [id], onDelete: Restrict)
  fromDistrictId Int            @map("from_district_id")
  fromDistrict   District       @relation("TransferFromDistrict", fields: [fromDistrictId], references: [id], onDelete: Restrict)
  toDistrictId   Int            @map("to_district_id")
  toDistrict     District       @relation("TransferToDistrict", fields: [toDistrictId], references: [id], onDelete: Restrict)
  requestedById  Int            @map("requested_by_id")
  requestedBy    User           @relation("TransferRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedById   Int?           @map("reviewed_by_id")
  reviewedBy     User?          @relation("TransferReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  status         TransferStatus @default(PENDING)
  activeKey      String?        @unique @map("active_key")
  reason         String
  reviewNote     String?        @map("review_note")
  requestedAt    DateTime       @default(now()) @map("requested_at")
  reviewedAt     DateTime?      @map("reviewed_at")
  effectiveAt    DateTime?      @map("effective_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([memberId])
  @@index([fromDistrictId])
  @@index([toDistrictId])
  @@index([status])
  @@index([requestedAt])
  @@map("member_transfers")
}

model ExternalClaimSubmission {
  id              Int                 @id @default(autoincrement())
  memberId        Int                 @map("member_id")
  member          Member              @relation(fields: [memberId], references: [id], onDelete: Restrict)
  submittedById   Int                 @map("submitted_by_id")
  submittedBy     User                @relation(fields: [submittedById], references: [id], onDelete: Restrict)
  provider        String              @default("MANKRADO")
  idempotencyKey  String              @unique @map("idempotency_key")
  externalClaimId String?             @unique @map("external_claim_id")
  formUrl         String?             @map("form_url")
  status          ExternalClaimStatus @default(PENDING)
  errorCode       String?             @map("error_code")
  errorMessage    String?             @map("error_message")
  submittedAt     DateTime?           @map("submitted_at")
  lastSyncedAt    DateTime?           @map("last_synced_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@index([memberId])
  @@index([submittedById])
  @@index([status])
  @@index([createdAt])
  @@map("external_claim_submissions")
}
