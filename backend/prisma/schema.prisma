// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  NATIONAL_ADMIN
  REGIONAL_ADMIN
  DISTRICT_ADMIN
}

enum MemberStatus {
  ACTIVE
  PENDING
  FLAGGED
  RETURNED
  REMOVED
}

enum BeneficiaryRelationship {
  CHILD
  SPOUSE
  PARENT
  SIBLING
  OTHER
}

enum FileCategory {
  MEMBER_DOCUMENT
  MARRIAGE_CERTIFICATE
  OTHER
}

model Region {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  districts District[]
  users     User[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model District {
  id        Int      @id @default(autoincrement())
  name      String
  regionId  Int
  region    Region   @relation(fields: [regionId], references: [id], onDelete: Restrict)
  users     User[]
  members   Member[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([regionId, name])
  @@index([regionId])
}

model User {
  id             Int            @id @default(autoincrement())
  fullName       String
  email          String         @unique
  passwordHash   String
  role           UserRole
  isActive       Boolean        @default(true)
  regionId       Int?
  districtId     Int?
  region         Region?        @relation(fields: [regionId], references: [id], onDelete: Restrict)
  district       District?      @relation(fields: [districtId], references: [id], onDelete: Restrict)
  createdMembers Member[]       @relation("MemberCreatedBy")
  refreshTokens  RefreshToken[]
  uploadedFiles  StoredFile[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([regionId])
  @@index([districtId])
}

model Member {
  id              Int           @id @default(autoincrement())
  controllerId    String        @unique
  fullName        String
  dateOfBirth     DateTime?     @db.Date
  ghanaCardId     String?       @unique
  phone           String?
  school          String
  status          MemberStatus  @default(PENDING)
  report20Matched Boolean       @default(false)
  districtId      Int
  createdById     Int?
  district        District      @relation(fields: [districtId], references: [id], onDelete: Restrict)
  createdBy       User?         @relation("MemberCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  spouse          Spouse?
  beneficiaries   Beneficiary[]
  files           StoredFile[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([districtId])
  @@index([status])
  @@index([fullName])
}

model Spouse {
  id          Int          @id @default(autoincrement())
  memberId    Int          @unique
  member      Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  fullName    String
  dateOfBirth DateTime?    @db.Date
  ghanaCardId String?      @unique
  files       StoredFile[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Beneficiary {
  id                 Int                     @id @default(autoincrement())
  memberId           Int
  member             Member                  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  fullName           String
  relationship       BeneficiaryRelationship
  dateOfBirth        DateTime?               @db.Date
  trusteeName        String?
  trusteeGhanaCardId String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([memberId])
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model StoredFile {
  id           Int          @id @default(autoincrement())
  category     FileCategory
  originalName String
  storedName   String       @unique
  mimeType     String
  sizeBytes    Int
  storagePath  String       @unique
  downloadPath String       @unique
  memberId     Int
  spouseId     Int?
  uploadedById Int
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  spouse       Spouse?      @relation(fields: [spouseId], references: [id], onDelete: SetNull)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime     @default(now())

  @@index([memberId])
  @@index([spouseId])
  @@index([uploadedById])
  @@index([category])
}
