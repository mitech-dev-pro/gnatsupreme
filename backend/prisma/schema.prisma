// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  NATIONAL_ADMIN
  REGIONAL_ADMIN
  DISTRICT_ADMIN
}

enum MemberStatus {
  ACTIVE
  PENDING
  FLAGGED
  RETURNED
  REMOVED
}

enum BeneficiaryRelationship {
  CHILD
  SPOUSE
  PARENT
  SIBLING
  OTHER
}

enum FileCategory {
  MEMBER_DOCUMENT
  MARRIAGE_CERTIFICATE
  REPORT_20
  MEMBER_IMPORT
  OTHER
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ExternalClaimStatus {
  PENDING
  REDIRECT_READY
  SUBMITTED
  FAILED
  SYNCHRONIZED
}

enum ImportType {
  REPORT_20
  MEMBER_BULK
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ImportRowStatus {
  MATCHED
  CHANGED
  UNMATCHED
  DUPLICATE
  INVALID
}

enum BenefitType {
  DEATH
  TOTAL_PERMANENT_DISABILITY
  CRITICAL_ILLNESS
  HOSPITALIZATION
}

enum BulkImportRowStatus {
  READY
  INVALID
  DUPLICATE
  EXISTING
  OUT_OF_SCOPE
  IMPORTED
  FAILED
}

enum MemberWorkflowAction {
  APPROVED
  RETURNED
  REMOVED
}

enum RemovalReason {
  DEATH
  DISABILITY
  RETIREMENT
  RESIGNATION
  OTHER
}

enum ChangeRequestType {
  MEMBER_DETAILS
  SPOUSE
  BENEFICIARY_ADD
  BENEFICIARY_UPDATE
  BENEFICIARY_REMOVE
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  RETURNED
  REJECTED
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  SMS
}

enum NotificationStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

model Region {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  districts District[]
  users     User[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model District {
  id                Int              @id @default(autoincrement())
  name              String
  regionId          Int
  region            Region           @relation(fields: [regionId], references: [id], onDelete: Restrict)
  users             User[]
  members           Member[]
  outgoingTransfers MemberTransfer[] @relation("TransferFromDistrict")
  incomingTransfers MemberTransfer[] @relation("TransferToDistrict")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([regionId, name])
  @@index([regionId])
}

model User {
  id                          Int                           @id @default(autoincrement())
  fullName                    String
  email                       String                        @unique
  passwordHash                String
  role                        UserRole
  isActive                    Boolean                       @default(true)
  regionId                    Int?
  districtId                  Int?
  region                      Region?                       @relation(fields: [regionId], references: [id], onDelete: Restrict)
  district                    District?                     @relation(fields: [districtId], references: [id], onDelete: Restrict)
  createdMembers              Member[]                      @relation("MemberCreatedBy")
  refreshTokens               RefreshToken[]
  uploadedFiles               StoredFile[]
  auditLogs                   AuditLog[]
  requestedTransfers          MemberTransfer[]              @relation("TransferRequestedBy")
  reviewedTransfers           MemberTransfer[]              @relation("TransferReviewedBy")
  claimSubmissions            ExternalClaimSubmission[]
  importJobs                  ImportJob[]
  benefitPlans                BenefitPlanVersion[]
  memberWorkflowEvents        MemberWorkflowEvent[]
  submittedChangeRequests     MemberChangeRequest[]         @relation("ChangeRequestedBy")
  reviewedChangeRequests      MemberChangeRequest[]         @relation("ChangeReviewedBy")
  notifications               Notification[]
  organizationSettingsUpdates OrganizationSettings[]
  organizationSettingVersions OrganizationSettingsVersion[]
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt

  @@index([regionId])
  @@index([districtId])
}

model Member {
  id               Int                       @id @default(autoincrement())
  controllerId     String                    @unique
  fullName         String
  dateOfBirth      DateTime?                 @db.Date
  ghanaCardId      String?                   @unique
  phone            String?
  phoneVerifiedAt  DateTime?
  school           String
  status           MemberStatus              @default(PENDING)
  report20Matched  Boolean                   @default(false)
  districtId       Int
  createdById      Int?
  district         District                  @relation(fields: [districtId], references: [id], onDelete: Restrict)
  createdBy        User?                     @relation("MemberCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  spouse           Spouse?
  beneficiaries    Beneficiary[]
  files            StoredFile[]
  transfers        MemberTransfer[]
  claimSubmissions ExternalClaimSubmission[]
  importRows       Report20Row[]
  bulkImportRows   MemberBulkImportRow[]
  workflowEvents   MemberWorkflowEvent[]
  changeRequests   MemberChangeRequest[]
  otpChallenges    MemberOtpChallenge[]
  memberSessions   MemberSession[]
  notifications    Notification[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([districtId])
  @@index([status])
  @@index([fullName])
}

model Spouse {
  id          Int          @id @default(autoincrement())
  memberId    Int          @unique
  member      Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  fullName    String
  dateOfBirth DateTime?    @db.Date
  ghanaCardId String?      @unique
  files       StoredFile[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Beneficiary {
  id                 Int                     @id @default(autoincrement())
  memberId           Int
  member             Member                  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  fullName           String
  relationship       BeneficiaryRelationship
  dateOfBirth        DateTime?               @db.Date
  trusteeName        String?
  trusteeGhanaCardId String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([memberId])
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model MemberOtpChallenge {
  id          Int       @id @default(autoincrement())
  publicToken String    @unique
  memberId    Int
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  otpHash     String
  expiresAt   DateTime
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  consumedAt  DateTime?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  @@index([memberId, createdAt])
  @@index([expiresAt])
}

model MemberSession {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  memberId  Int
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  @@index([memberId])
  @@index([expiresAt])
}

model Notification {
  id                Int                 @id @default(autoincrement())
  channel           NotificationChannel
  status            NotificationStatus  @default(QUEUED)
  type              String
  title             String
  message           String
  idempotencyKey    String              @unique
  userId            Int?
  user              User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberId          Int?
  member            Member?             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  destination       String?
  attempts          Int                 @default(0)
  maxAttempts       Int                 @default(5)
  nextAttemptAt     DateTime            @default(now())
  providerMessageId String?
  lastError         String?
  sentAt            DateTime?
  readAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([status, nextAttemptAt])
  @@index([userId, readAt, createdAt])
  @@index([memberId, readAt, createdAt])
  @@index([type])
}

model OrganizationSettings {
  id                   Int                           @id @default(autoincrement())
  singletonKey         String                        @unique @default("MILIFE")
  portalName           String                        @default("GNAT Supreme Care")
  schemeSponsor        String                        @default("GNAT")
  underwriter          String                        @default("miLife Insurance")
  sidebarMark          String                        @default("GS")
  primaryColor         String                        @default("#102A43")
  accentColor          String                        @default("#00A896")
  memberIdLabel        String                        @default("Controller ID")
  reconciliationSource String                        @default("CAGD Report 20")
  subRegionLabel       String                        @default("District")
  organizationEmail    String?
  organizationPhone    String?
  address              String?
  websiteUrl           String?
  privacyNotice        String?
  timezone             String                        @default("Africa/Accra")
  currency             String                        @default("GHS")
  version              Int                           @default(1)
  updatedById          Int?
  updatedBy            User?                         @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  versions             OrganizationSettingsVersion[]
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  @@index([updatedById])
}

model OrganizationSettingsVersion {
  id            Int                  @id @default(autoincrement())
  settingsId    Int
  settings      OrganizationSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  version       Int
  snapshot      Json
  changedFields Json
  changedById   Int?
  changedBy     User?                @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now())

  @@unique([settingsId, version])
  @@index([changedById])
  @@index([createdAt])
}

model StoredFile {
  id           Int          @id @default(autoincrement())
  category     FileCategory
  originalName String
  storedName   String       @unique
  mimeType     String
  sizeBytes    Int
  storagePath  String       @unique
  downloadPath String       @unique
  memberId     Int?
  spouseId     Int?
  uploadedById Int
  member       Member?      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  spouse       Spouse?      @relation(fields: [spouseId], references: [id], onDelete: SetNull)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime     @default(now())
  importJob    ImportJob?

  @@index([memberId])
  @@index([spouseId])
  @@index([uploadedById])
  @@index([category])
}

model ImportJob {
  id            Int                   @id @default(autoincrement())
  type          ImportType
  status        ImportStatus          @default(PENDING)
  checksum      String
  fileId        Int                   @unique
  file          StoredFile            @relation(fields: [fileId], references: [id], onDelete: Restrict)
  uploadedById  Int
  uploadedBy    User                  @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  reportMonth   DateTime?             @db.Date
  totalRows     Int                   @default(0)
  matchedRows   Int                   @default(0)
  changedRows   Int                   @default(0)
  unmatchedRows Int                   @default(0)
  duplicateRows Int                   @default(0)
  invalidRows   Int                   @default(0)
  errorMessage  String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  rows          Report20Row[]
  memberRows    MemberBulkImportRow[]
  readyRows     Int                   @default(0)
  importedRows  Int                   @default(0)

  @@unique([type, checksum])
  @@index([status])
  @@index([createdAt])
}

model Report20Row {
  id           Int             @id @default(autoincrement())
  importJobId  Int
  importJob    ImportJob       @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  rowNumber    Int
  controllerId String?
  fullName     String?
  districtName String?
  school       String?
  ghanaCardId  String?
  status       ImportRowStatus
  memberId     Int?
  member       Member?         @relation(fields: [memberId], references: [id], onDelete: SetNull)
  issues       Json?
  rawData      Json
  createdAt    DateTime        @default(now())

  @@unique([importJobId, rowNumber])
  @@index([importJobId, status])
  @@index([controllerId])
  @@index([memberId])
}

model MemberBulkImportRow {
  id              Int                 @id @default(autoincrement())
  importJobId     Int
  importJob       ImportJob           @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  rowNumber       Int
  controllerId    String?
  fullName        String?
  school          String?
  districtName    String?
  districtId      Int?
  dateOfBirth     DateTime?           @db.Date
  ghanaCardId     String?
  phone           String?
  report20Matched Boolean             @default(false)
  status          BulkImportRowStatus
  memberId        Int?
  member          Member?             @relation(fields: [memberId], references: [id], onDelete: SetNull)
  issues          Json?
  rawData         Json
  createdAt       DateTime            @default(now())

  @@unique([importJobId, rowNumber])
  @@index([importJobId, status])
  @@index([controllerId])
  @@index([memberId])
  @@index([districtId])
}

model MemberWorkflowEvent {
  id            Int                  @id @default(autoincrement())
  memberId      Int
  member        Member               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  action        MemberWorkflowAction
  fromStatus    MemberStatus
  toStatus      MemberStatus
  reason        RemovalReason?
  note          String?
  performedById Int
  performedBy   User                 @relation(fields: [performedById], references: [id], onDelete: Restrict)
  createdAt     DateTime             @default(now())

  @@index([memberId, createdAt])
  @@index([action])
  @@index([performedById])
}

model MemberChangeRequest {
  id                  Int                 @id @default(autoincrement())
  memberId            Int
  member              Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type                ChangeRequestType
  status              ChangeRequestStatus @default(PENDING)
  targetBeneficiaryId Int?
  proposedData        Json?
  requestNote         String?
  requestedById       Int?
  requestedBy         User?               @relation("ChangeRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedById        Int?
  reviewedBy          User?               @relation("ChangeReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote          String?
  requestedAt         DateTime            @default(now())
  reviewedAt          DateTime?
  updatedAt           DateTime            @updatedAt

  @@index([memberId, status])
  @@index([requestedById])
  @@index([reviewedById])
  @@index([requestedAt])
}

model BenefitPlanVersion {
  id               Int             @id @default(autoincrement())
  effectiveFrom    DateTime        @unique @db.Date
  monthlyPremium   Decimal         @db.Decimal(12, 2)
  collectionMethod String
  note             String?
  createdById      Int
  createdBy        User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  benefits         BenefitAmount[]
  createdAt        DateTime        @default(now())

  @@index([effectiveFrom])
  @@index([createdById])
}

model BenefitAmount {
  id            Int                @id @default(autoincrement())
  planVersionId Int
  planVersion   BenefitPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  type          BenefitType
  enabled       Boolean            @default(true)
  memberAmount  Decimal            @db.Decimal(14, 2)
  spouseAmount  Decimal?           @db.Decimal(14, 2)

  @@unique([planVersionId, type])
  @@index([type])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorId     Int?
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail  String?
  action      String
  entityType  String
  entityId    String?
  description String
  beforeData  Json?
  afterData   Json?
  regionId    Int?
  districtId  Int?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([regionId])
  @@index([districtId])
  @@index([createdAt])
}

model MemberTransfer {
  id             Int            @id @default(autoincrement())
  memberId       Int
  member         Member         @relation(fields: [memberId], references: [id], onDelete: Restrict)
  fromDistrictId Int
  fromDistrict   District       @relation("TransferFromDistrict", fields: [fromDistrictId], references: [id], onDelete: Restrict)
  toDistrictId   Int
  toDistrict     District       @relation("TransferToDistrict", fields: [toDistrictId], references: [id], onDelete: Restrict)
  requestedById  Int
  requestedBy    User           @relation("TransferRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedById   Int?
  reviewedBy     User?          @relation("TransferReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  status         TransferStatus @default(PENDING)
  activeKey      String?        @unique
  reason         String
  reviewNote     String?
  requestedAt    DateTime       @default(now())
  reviewedAt     DateTime?
  effectiveAt    DateTime?
  updatedAt      DateTime       @updatedAt

  @@index([memberId])
  @@index([fromDistrictId])
  @@index([toDistrictId])
  @@index([status])
  @@index([requestedAt])
}

model ExternalClaimSubmission {
  id              Int                 @id @default(autoincrement())
  memberId        Int
  member          Member              @relation(fields: [memberId], references: [id], onDelete: Restrict)
  submittedById   Int
  submittedBy     User                @relation(fields: [submittedById], references: [id], onDelete: Restrict)
  provider        String              @default("MANKRADO")
  idempotencyKey  String              @unique
  externalClaimId String?             @unique
  formUrl         String?
  status          ExternalClaimStatus @default(PENDING)
  errorCode       String?
  errorMessage    String?
  submittedAt     DateTime?
  lastSyncedAt    DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([memberId])
  @@index([submittedById])
  @@index([status])
  @@index([createdAt])
}
